{
  "name": "remarkable-tagged-sync",
  "version": "1.9.1",
  "description": "Sync tagged reMarkable notebooks into Obsidian as searchable Markdown notes, routed to folders by tag.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint .",
    "generate:kaitai": "node src/kaitai/generate.mjs",
    "inspect:rm": "esbuild scripts/inspect-rm.ts --bundle --platform=node --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-inspect-rm.cjs && node /tmp/tagged-sync-inspect-rm.cjs",
    "inspect:doc": "esbuild scripts/inspect-doc.ts --bundle --platform=node --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-inspect-doc.cjs && node /tmp/tagged-sync-inspect-doc.cjs",
    "test:coverage": "vitest run --coverage",
    "matrix": "node scripts/matrix-link.mjs",
    "nightly:ocr": "esbuild tests/support/nightly/ocr-main.ts --bundle --platform=node --alias:obsidian=./tests/stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-nightly-ocr.cjs && node /tmp/tagged-sync-nightly-ocr.cjs",
    "nightly:vision": "esbuild tests/support/nightly/vision-main.ts --bundle --platform=node --alias:obsidian=./tests/stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-nightly-vision.cjs && node /tmp/tagged-sync-nightly-vision.cjs",
    "measure:local": "esbuild tests/support/local-ocr/measure-main.ts --bundle --platform=node --alias:obsidian=./tests/stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-measure-local.cjs && node /tmp/tagged-sync-measure-local.cjs",
    "nightly:perf": "esbuild tests/support/nightly/perf-main.ts --bundle --platform=node --alias:obsidian=./tests/stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-nightly-perf.cjs && node /tmp/tagged-sync-nightly-perf.cjs",
    "check:text-layer": "esbuild tests/support/text-layer/check-main.ts --bundle --platform=node --alias:obsidian=./tests/stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-check-text-layer.cjs && node /tmp/tagged-sync-check-text-layer.cjs",
    "ocr:curve": "node scripts/ocr-curve.mjs",
    "images:update": "esbuild tests/support/reference-images/update-main.ts --bundle --platform=node --alias:obsidian=./tests/stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-images-update.cjs && node /tmp/tagged-sync-images-update.cjs",
    "goldens:update": "esbuild tests/support/golden/update-main.ts --bundle --platform=node --alias:obsidian=./tests/stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-goldens-update.cjs && node /tmp/tagged-sync-goldens-update.cjs",
    "freeze-state": "esbuild scripts/legacy-state/freeze.ts --bundle --platform=node --format=esm --alias:obsidian=./tests/stubs/obsidian.ts --external:iconv-lite --outfile=/tmp/tagged-sync-freeze-state.mjs && node /tmp/tagged-sync-freeze-state.mjs"
  },
  "license": "SEE LICENSE IN LICENSING.md",
  "dependencies": {
    "kaitai-struct": "^0.11.0",
    "pdf-lib": "^1.17.1",
    "rmapi-js": "^14.4.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.13.0",
    "kaitai-struct-compiler": "^0.11.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
