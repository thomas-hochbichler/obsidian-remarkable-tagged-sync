{
  "name": "remarkable-tagged-sync",
  "version": "1.4.4",
  "description": "Sync tagged reMarkable notebooks into Obsidian as searchable Markdown notes, routed to folders by tag.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint .",
    "generate:kaitai": "node src/kaitai/generate.mjs",
    "inspect:rm": "esbuild scripts/inspect-rm.ts --bundle --platform=node --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-inspect-rm.cjs && node /tmp/tagged-sync-inspect-rm.cjs",
    "inspect:doc": "esbuild scripts/inspect-doc.ts --bundle --platform=node --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-inspect-doc.cjs && node /tmp/tagged-sync-inspect-doc.cjs",
    "test:coverage": "vitest run --coverage",
    "matrix": "node scripts/matrix-link.mjs",
    "nightly:ocr": "esbuild test-support/nightly/ocr-main.ts --bundle --platform=node --alias:obsidian=./test-stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-nightly-ocr.cjs && node /tmp/tagged-sync-nightly-ocr.cjs",
    "nightly:perf": "esbuild test-support/nightly/perf-main.ts --bundle --platform=node --alias:obsidian=./test-stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-nightly-perf.cjs && node /tmp/tagged-sync-nightly-perf.cjs",
    "ocr:curve": "node scripts/ocr-curve.mjs",
    "goldens:update": "esbuild test-support/golden/update-main.ts --bundle --platform=node --alias:obsidian=./test-stubs/obsidian.ts --external:iconv-lite --format=cjs --outfile=/tmp/tagged-sync-goldens-update.cjs && node /tmp/tagged-sync-goldens-update.cjs",
    "freeze-state": "esbuild scripts/legacy-state/freeze.ts --bundle --platform=node --format=esm --alias:obsidian=./test-stubs/obsidian.ts --external:iconv-lite --outfile=/tmp/tagged-sync-freeze-state.mjs && node /tmp/tagged-sync-freeze-state.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "kaitai-struct": "^0.11.0",
    "pdf-lib": "^1.17.1",
    "rmapi-js": "^11.1.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "@types/ssh2": "^1.15.5",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.8.0",
    "kaitai-struct-compiler": "^0.11.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
